{
	"name": "wikijs-publisher",
	"version": "0.0.0",
	"description": "Obsidian plugin to send notes to a Wiki.js instance",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "vitest run tests/unit",
		"test:integration": "vitest run tests/integration"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@types/node": "26.6.6",
		"esbuild": "0.28.2",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "17.14.0",
		"jiti": "2.7.0",
		"obsidian": "1.14.4",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.1",
		"vitest": "5.1.0"
	}
}
