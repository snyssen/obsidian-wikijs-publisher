{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "group:allNonMajor",
    "group:allDigest",
    ":pinAllExceptPeerDependencies",
    ":semanticCommits",
    ":automergeMinor",
    ":automergeBranch"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "The dev environment runs one Wiki.js instance per major version (v2 and v3): only update each within its major",
      "matchPackageNames": [
        "ghcr.io/requarks/wiki"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
